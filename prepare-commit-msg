#!/usr/bin/env bash

set -ex

# Exit immediately if there are no staged changes
if ! git diff --cached --name-only > /dev/null 2>&1; then
    exit 0
fi

# Exit immediately for merge commits
if [ -n "$2" ] && [ "$2" = "merge" ] || git rev-parse --quiet --verify MERGE_HEAD >/dev/null 2>&1; then
    exit 0
fi

: ${AIDER_COMMIT_CMD:=aider}
: ${AIDER_COMMIT_MODEL:=ollama_chat/gpt-oss}
: ${_AIDER_COMMIT_DIFF_FILE:=diff_file}
: ${_AIDER_COMMIT_SUMMARY_FILE:=summary_file}

# Create temp directory to isolate the AI
tmp_dir=$(mktemp -d)
git init $tmp_dir
git diff --staged > "$tmp_dir/$_AIDER_COMMIT_DIFF_FILE"

branch=$(git rev-parse --abbrev-ref HEAD)

cd $tmp_dir

_AIDER_COMMIT_PROMPT="
    DO NOT MODIFY ANY EXISTING FILES.
    DO NOT REPEAT OR SUMMARIZE THIS REQUEST.

    You are an expert programmer writing a concise commit summary.
    Summarize the git diff changes found in the file ${_AIDER_COMMIT_DIFF_FILE} with a single line describing all of the changes followed by an empty line and then a few short bullet points.
    Use the imperative mood and begin each bullet with '-'.
    Focus on high level actions, avoiding repetition of file summaries.
    Return no more than five bullet points.

    Write the summary table to the file ${_AIDER_COMMIT_SUMMARY_FILE}
"

timeout 300 ${AIDER_COMMIT_CMD} --model ${AIDER_COMMIT_MODEL} --message "${_AIDER_COMMIT_PROMPT}" ${_AIDER_COMMIT_DIFF_FILE}

cd -

tmp_output=$(mktemp)
cat "$tmp_dir/${_AIDER_COMMIT_SUMMARY_FILE}" "$1" > "$tmp_output" && mv "$tmp_output" "$1"

rm -r "$tmp_dir"
